# Generate fresh local secrets with: python3 scripts/init_env.py
# This file contains no usable credentials.
POSTGRES_PASSWORD=
MIGRATION_DB_PASSWORD=
WORKER_DB_PASSWORD=
APP_DB_PASSWORD=
APP_DB_HOST=127.0.0.1
APP_DB_PORT=15432
APP_DB_NAME=payment_ledger
API_PORT=8000
APP_SESSION_TTL_SECONDS=3600
APP_AUTH_RATE_LIMIT=20
APP_AUTH_RATE_WINDOW_SECONDS=60

